@page
@model AutoCollection.Pages.AutomobilePages.IndexModel

@{
    ViewData["Title"] = "Index";
}
<div class="row">
    <div class="col-md-6">
        <div class="text-center">
            <h1 class="text-success display-1 fw-bold">Automobiles</h1>
        </div>
    </div>
    <div class="col-md-6">
        <div class="text-center">
            <img src="~/images/greencar.png" class="mx-auto d-block" style="width:400px" />
            </div>
            </div>
</div>
<p>
    <a asp-page="Create" class="text-success display-5">Create New</a>
</p>

<form>
    <p>
        Make:<input type="text" asp-for="SearchString"/>
        <input type="submit" value="filter" />
    </p>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th class="bg-success text-white">
                @Html.DisplayNameFor(model => model.Automobile[0].Make)
            </th>
            <th class="bg-success text-white">
                @Html.DisplayNameFor(model => model.Automobile[0].Model)
            </th>
            <th class="bg-success text-white">
                @Html.DisplayNameFor(model => model.Automobile[0].Year)
            </th>
            <th class="bg-success text-white">
                @Html.DisplayNameFor(model => model.Automobile[0].Type)
            </th>
            <th class="bg-success text-white">
                @Html.DisplayNameFor(model => model.Automobile[0].Price)
            </th>
            <th class="bg-success text-white">
                @Html.DisplayNameFor(model => model.Automobile[0].Age)
            </th>
            <th class ="bg-success text-white"></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Automobile) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Make)
            </td>
            <td>
                @Html.DisplayFor(model => item.Model)
            </td>
            <td>
                @Html.DisplayFor(model => item.Year)
            </td>
            <td>
                @Html.DisplayFor(model => item.Type)
            </td>
            <td>
                @Html.DisplayFor(model => item.Price)
            </td>
            <td>
                @Html.DisplayFor(model => item.Age)
            </td>
            <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="text-success">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.Id" class="text-success">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="text-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
