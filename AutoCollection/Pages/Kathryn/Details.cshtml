@page
@model AutoCollection.Pages.AutomobilePages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<div>
    <a asp-page="./Index" class=" btn btn-success">Back</a>
</div>

<h1 class="text-success display-1 fw-bold">Details</h1>

<div>
    <dl class="row border border-success border-5 rounded">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Make)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Make)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Model)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Model)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Year)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Year)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Type)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Type)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Price)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Price)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Age)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Age)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Automobile.Id" class="text-success">Edit</a> |
    <a asp-page="./Delete" asp-route-id="@Model.Automobile.Id" class="text-danger">Delete</a>
</div>
