@page
@model AutoCollection.Pages.AutomobilePages.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1 style="font-size:30px;
           color:black;
           margin-bottom:25px;">
    Automobile
</h1>

<h2 style="font-size:24px;
           margin-bottom:20px;">
    Delete Auto
</h2>

<p style="font-size:18px;
          margin-bottom:25px;">
    Are you sure you want to delete this automobile?
</p>

<hr />

<div>
    <hr />
    <dl class="row">
<!-- MAKE FIELD -->
<div style="display:flex;
            align-items:center;
            margin-bottom:20px;
            gap:20px;">

    <label style="width:120px;
                  font-size:20px;">
        Make
    </label>

    <div style="background-color:#d9d9d9;
                border:1px solid #cccccc;
                padding:10px;
                width:250px;">

        @Html.DisplayFor(model => model.Automobile.Make)

    </div>
</div>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Model)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Model)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Year)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Year)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Type)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Type)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Price)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Price)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Age)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Age)
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Automobile.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
