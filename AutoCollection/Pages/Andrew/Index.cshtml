@page
@model AutoCollection.Pages.Andrew.IndexModel

@{
    ViewData["Title"] = "Index";
}
<body class="bg-dark">
    <div class="p-3">
    <h1 class="text-white">Index</h1>

    <div class="btn btn-success ">
        <a class="text-decoration-none text-white" asp-page="Create">Create New</a>
    </div>
    </div>
    <div class="text-center d-flex flex-wrap gap-3 ">
@foreach (var item in Model.Automobile) {
        <div style="height:80%" class="border bg-black d-flex flex-lg-column p-5 text-white ">
            <p>
                @Html.DisplayFor(model => item.Make)
            </p>
            <p>
                @Html.DisplayFor(model => item.Model)
            </p>
            <p>
                @Html.DisplayFor(model => item.Year)
            </p>
            <p>
                @Html.DisplayFor(model => item.Type)
            </p>
            <p>
                @Html.DisplayFor(model => item.Price)
            </p>
            <p>
                @Html.DisplayFor(model => item.Age)
            </p>
            <div>
                <div class="btn btn-success">
                    <a class="text-decoration-none text-white " asp-page="./Edit" asp-route-id="@item.Id">Edit</a> 
                </div>
                <div class="btn btn-dark">
                    <a class="text-decoration-none text-white " asp-page="./Details" asp-route-id="@item.Id">Details</a> 
                </div>
                <div class="btn btn-danger">
                    <a class="text-decoration-none text-white " asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                </div>
            </div>
        </div>
}
</div>
</body>