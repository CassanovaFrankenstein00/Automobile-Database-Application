@page
@using AutoCollection.Pages.Jerry
@model AutoCollection.Pages.AutomobilePages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Automobile[0].Make)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Automobile[0].Model)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Automobile[0].Year)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Automobile[0].Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Automobile[0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Automobile[0].Age)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Automobile) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Make)
            </td>
            <td>
                @Html.DisplayFor(model => item.Model)
            </td>
            <td>
                @Html.DisplayFor(model => item.Year)
            </td>
            <td>
                @Html.DisplayFor(model => item.Type)
            </td>
            <td>
                @Html.DisplayFor(model => item.Price)
            </td>
            <td>
                @Html.DisplayFor(model => item.Age)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
