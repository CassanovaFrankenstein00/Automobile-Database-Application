@page
@model AutoCollection.Pages.Andrew.CreateModel

@{
    ViewData["Title"] = "Create";
}
<body class="bg-dark">

<hr />
<div class="row bg-black text-white p-3 rounded">
    <h1 class="text-center">Create</h1>
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Automobile.Make" class="control-label"></label>
                <input asp-for="Automobile.Make" class="form-control" aria-required="true" />
                <span asp-validation-for="Automobile.Make" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Automobile.Model" class="control-label"></label>
                <input asp-for="Automobile.Model" class="form-control" aria-required="true" />
                <span asp-validation-for="Automobile.Model" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Automobile.Year" class="control-label"></label>
                <input asp-for="Automobile.Year" class="form-control" aria-required="true" />
                <span asp-validation-for="Automobile.Year" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Automobile.Type" class="control-label"></label>
                <select asp-for="Automobile.Type" class="form-control" asp-items="Html.GetEnumSelectList<AutoCollection.Models.Type>()">
                        <option value="">-- Select Type --</option>
                </select>
                <span asp-validation-for="Automobile.Type" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Automobile.Price" class="control-label"></label>
                <input asp-for="Automobile.Price" class="form-control" />
                <span asp-validation-for="Automobile.Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Automobile.Age" class="control-label"></label>
                <input asp-for="Automobile.Age" class="form-control" />
                <span asp-validation-for="Automobile.Age" class="text-danger"></span>
            </div>
            <section class="d-flex p-3 justify-content-between">
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-success" />
                </div>
                <div class=" btn btn-danger">
                    <a class="text-decoration-none text-white " asp-page="./Index">Back to List</a>
                </div>
            </section>
        </form>
    </div>
</div>
</body>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
