@page
@model AutoCollection.Pages.Andrew.DeleteModel

@{
    ViewData["Title"] = "Delete";
}
<body class="bg-dark text-white">
<div class="bg-black p-3 rounded-1">
 <div class="text-center">
<h1>Delete</h1>

<h3>Are you sure you want to delete this Automobile?</h3>
</div>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Make)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Make)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Model)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Model)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Year)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Year)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Type)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Type)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Price)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Price)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Automobile.Age)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Automobile.Age)
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Automobile.Id" />
        <input type="submit" value="Yes" class="btn btn-success" /> 
        <div class="btn btn-danger">
        <a class="text-decoration-none text-white " asp-page="./Index">No</a>
        </div>
    </form>
</div>
</div>
</body>